# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local / secrets
.env.local
.env.*.local
!.env.example

# supabase
supabase/.temp
supabase/.branches

# playwright / vitest
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel local link
.vercel

# agent / OS
*.log
.DS_Store

# large local 3d assets (keep small samples)
/public/models/*.glb
!/public/models/.gitkeep

# OS / IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Internal strategy / pitch / audit docs (keep local; do not publish with the site repo)
/docs/
.impeccable/
.tmp/
